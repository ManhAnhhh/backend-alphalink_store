<%- include('../layout/head', { pageTitle: 'Quản lý danh mục'}) %>

<style>
  .cat_parrent,
  .cat_children {
    color: #858796;
    text-decoration: none !important;
  }
  .cat_children:hover,
  .cat_parrent:hover {
    color: #4e73df;
    cursor: pointer;
    transition: all 0.5s;
  }
</style>
<body id="page-top">
  <!-- Page Wrapper -->
  <div id="wrapper">
    <!-- Sidebar -->
    <%- include('../layout/sidebar') %>
    <!-- End of Sidebar -->

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">
      <!-- Main Content -->
      <div id="content">
        <!-- Topbar -->
        <%- include('../layout/search') %>
        <!-- End of Topbar -->

        <!-- Begin Page Content -->
        <div class="container-fluid">
          <!-- Page Heading -->
          <h3 class="h3 mb-2 text-gray-800">
            Danh sách danh mục (<span class="totalCategories"><%= categories.length %></span>)
          </h3>
          <div class="card shadow mb-4">
            
            <div class="card-body">
              <div class="table-responsive">
                <table
                  class="table table-bordered"
                  id="dataTable"
                  width="100%"
                  cellspacing="0"
                >
                  <thead>
                    <tr>
                      <th>Danh mục</th>
                      <th>Sản phẩm</th>
                      <th>Trạng thái</th>
                      <th></th>
                    </tr>
                  </thead>

                  <tbody>
                    <% for(const category of categories) {%>
                        <tr>
                          <td >
                            <a class="cat_parrent" href="/admin/categories/edit/<%=category._id%>">
                              <i class="fa-solid fa-folder mr-1"></i>
                              <%=category.name%>
                              <%= category.children_count > 0 ? `(${category.children_count})` : '' %>
                            </a>
                          </td>
                          <td><%=category.product_count%></td>
                          <% if(category.status == 'inactive') { %>
                            <td class="text-danger">Không hoạt động</td>
                          <% } else { %>
                            <td class="text-success">Hoạt động</td>
                          <% } %>
                        
                          <td></td>
                        </tr>
                      <% for(const category_children of category.children) {%>
                        <tr style="font-size: 14px;">
                          <td style="min-width: 250px;">
                            <div class="d-flex gap-2 align-items-center">
                              <div class="ml-4">
                                <a class="cat_children" href="/admin/categories/edit/<%=category_children._id%>">
                                  <%=category_children.name%>
                                </a>
                              </div>
                            </div>
                          </td>
                          <td style="min-width: 250px;">
                            <div class="d-flex gap-2 align-items-center justify-content-center">
                              <div class="">
                                <%=category_children.product_count%>
                              </div>
                            </div>
                          </td>
                          <% if(category_children.status == 'inactive') { %>
                            <td class="text-danger">Không hoạt động</td>
                          <% } else { %>
                            <td class="text-success">Hoạt động</td>
                          <% } %>
                          <td class="form-group">
                            <button
                              data-id="<%=category_children._id%>"
                              class="btn btn-danger btn-delete"
                            >
                              <i class="fa-solid fa-trash"></i>
                            </button>
                            
                          </td>
                        </tr>
                      <% } %>
                    <%}%>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <!-- /.container-fluid -->
      </div>
      <!-- End of Main Content -->

      <!-- Footer -->
      <%- include('../layout/footer') %>
      <!-- End of Footer -->
    </div>
    <!-- End of Content Wrapper -->
  </div>
  <!-- End of Page Wrapper -->

  <%- include('../layout/script') %>
</body>

<script>
  const deleteCategory = document.querySelectorAll(".btn-delete");
  deleteCategory.forEach((item) => {
    item.addEventListener("click", function (e) {
      const categoryId = this.getAttribute("data-id");
      Swal.fire({
        title: "Bạn có chắc chắn muốn xóa?",
        text:"Danh mục sẽ không thể khôi phục lại",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Xóa",
        cancelButtonText: "Hủy",
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/admin/categories/delete/${categoryId}`, {
            method: 'POST'
          })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              $(".totalCategories").each(function() {
                $(this).text(`${data.totalCategories}`);
              });
              Swal.fire({
                toast: true,
                position: "top",
                icon: "success",
                title: "Xóa thành công",
                showConfirmButton: false,
                timer: 1000,
              });

              setTimeout(() => {
                location.reload();
              }, 1000);
              
            }
          })
          .catch(err => {
            Swal.fire('Lỗi', 'Không thể kết nối server', 'error');
            console.log(err);
          });
        }
      });
    });
  });
</script>
