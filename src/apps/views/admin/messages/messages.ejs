<%- include('../layout/head') %>

<style>
  .item-message {
    cursor: pointer;
    padding: 0.75rem;
    border-radius: 8px;
  }
  .item-message:first-child,
  .item-message:first-child:hover {
    background-color: #dceaf9 !important;
  }
  .item-message:hover {
    background-color: #e6e6e6;
  }
  .scroll-to-top {
    display: none !important;
  }
  .card-body {
    padding: 1rem;
  }
  .input-message {
    outline: none;
    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
  }
  .btn-send {
    padding: 6px;
  }
  .btn-send:hover {
    background-color: rgba(35, 110, 249, 0.2);
    transition: all .5s ease;
  } 
</style>

