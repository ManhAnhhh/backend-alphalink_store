<%- include('../layout/head', { pageTitle: 'Quản lý sản phẩm'}) %>

<body id="page-top">
  <!-- Page Wrapper -->
  <div id="wrapper">
    <!-- Sidebar -->
    <%- include('../layout/sidebar') %>
    <!-- End of Sidebar -->

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">
      <!-- Main Content -->
      <div id="content">
        <!-- Topbar -->
        <%- include('../layout/search') %>
        <!-- End of Topbar -->

        <!-- Begin Page Content -->
        <div class="container-fluid">
          <!-- Page Heading -->
          <h3 class="h3 mb-2 text-gray-800">
            Danh sách sản phẩm <span class="totalActive">(<%= products.length %>)</span>
          </h3>
          <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
              <div>
                <a href="/admin/products/">Tất cả sản phẩm <span class="totalActive">(<%= products.length %>)</span></a>
                <span class="ml-1 mr-1 d-inline-block" style="width: 2px; height: 12px; background-color: #bdbdbd;"></span>
                <a class="text-secondary" href="/admin/products/remove">Thùng rác <span class="totalInactive">(<%= productsInactive.length %>)</span></a>
              </div>

              <div>
                <a
                href="/admin/products/create"
                class="btn-primary border-0 rounded px-3 py-2 text-decoration-none"
                >
                  Thêm sản phẩm
                </a>
              </div>
            </div>
            <div class="card-body">
              <!-- Select dropdown để lọc -->
              <div>Danh mục</div>
              <select id="catFilter" class="form-control mb-2" style="width: 180px;">
                <option value="">Tất cả</option>
                <% for (const cat of categories) { %>
                    <option value="<%= cat.name %>"><%= cat.name %></option>
                <% } %>
              </select>
              <div class="table-responsive">
                <table
                  class="table table-bordered"
                  id="dataTable"
                  width="100%"
                  cellspacing="0"
                >
                  <thead>
                    <tr>
                      <th>Sản phẩm</th>
                      <th style="text-wrap: no-wrap;">Số lượng</th>
                      <th>Giá tiền</th>
                      <th>Đã bán</th>
                      <th class="text-left">Danh mục</th>
                      <th class="">Ngày tạo</th>
                      <th class="">Ngày sửa</th>
                      <th></th>
                    </tr>
                  </thead>

                  <tbody>
                    <% for(const product of products) {%>
                    <tr>
                      <td style="min-width: 250px;">
                        <div class="d-flex gap-2 align-items-center">
                          <img
                            width="60"
                            height="60"
                            src="../uploads/products/<%=product.img[0]%> "
                          />
                          <div class="ml-3">
                            <%=product.name%>
                          </div>
                        </div>
                      </td>
                      <td>
                        <%=product.stock%>
                      </td>
                      <td>
                        <%=formattedPriceVND(product.price)%>
                      </td>
                      <td>
                        <%=product.sold%>
                      </td>
                      <td class="text-left">
                        <%= capitalizeFirstLetter(product.category_info.name) %>
                      </td>

                      <td style="width: 115px; text-wrap: auto;">
                        <%=formatDateToYYYYMMDD(product.createdAt)%>
                      </td>

                      <td style="width: 115px; text-wrap: auto;">
                        <%=formatDateToYYYYMMDD(product.updatedAt)%>
                      </td>

                      <td class="form-group">
                        <a
                          href="/admin/products/edit/<%=product._id%>"
                          class="btn btn-primary"
                        >
                          <i class="fa-solid fa-pencil"></i>
                        </a>
                        <button
                          data-id="<%=product._id%>"
                          class="btn btn-danger btn-delete"
                        >
                          <i class="fa-solid fa-trash"></i>
                        </button>
                        <!--  -->
                      </td>
                    </tr>

                    <%}%>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <!-- /.container-fluid -->
      </div>
      <!-- End of Main Content -->

      <!-- Footer -->
      <%- include('../layout/footer') %>
      <!-- End of Footer -->
    </div>
    <!-- End of Content Wrapper -->
  </div>
  <!-- End of Page Wrapper -->

  <%- include('../layout/script') %>
</body>

<script>
  const deleteProduct = document.querySelectorAll(".btn-delete");
  deleteProduct.forEach((item) => {
    item.addEventListener("click", function (e) {
      const productId = this.getAttribute("data-id");
      // console.log(productId);

      fetch(`/admin/products/trash/${productId}`, {
            method: 'POST'
          })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              $(".totalActive").each(function() {
                $(this).text(`(${data.totalActive})`);
              });
              $(".totalInactive").each(function() {
                $(this).text(`(${data.totalInactive})`);
              });
              

              Swal.fire({
              toast: true,
              position: "top",
              icon: "success",
              title: "Sản phẩm đã được chuyển vào thùng rác",
              showConfirmButton: false,
              timer: 3000,
            });
            e.target.closest("tr").remove(); // Xóa dòng sản phẩm khỏi bảng
            }
          })
          .catch(err => {
            Swal.fire('Lỗi', 'Không thể kết nối server', 'error');
            console.log(err);
          });
    });
  });
</script>


<script>
  $(document).ready(function () {
    var table = $('#dataTable').DataTable();

    // Lắng nghe sự kiện thay đổi dropdown
    $('#catFilter').on('change', function () {
      var selected = $(this).val();
      table.column(4).search(selected).draw(); // Cột số 0 là Danh mục
    });
  });
</script>
